{
  "name": "fitness-local",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:diagnostic",
    "test:unit": "vitest run --exclude tests/training-engine/diagnostic.test.ts",
    "test:diagnostic": "vitest run tests/training-engine/diagnostic.test.ts",
    "build": "vite build",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy --config wrangler.production.jsonc",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 5176",
    "catalog:prepare": "node tools/catalog/build.mjs",
    "predev": "npm run catalog:prepare && npm run engine:prepare",
    "pretypecheck": "npm run catalog:prepare && npm run engine:prepare",
    "prebuild": "npm run catalog:prepare && npm run engine:prepare",
    "pretest": "npm run catalog:prepare && npm run engine:prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node tools/v8/check.mjs && node tools/check-layers.mjs",
    "engine:prepare": "node tools/training-engine/compile-annotations.ts",
    "engine:check": "node tools/training-engine/check-data.ts && node tools/training-engine/coverage.ts",
    "engine:fast": "node tools/training-engine/fast.mjs",
    "engine:full": "node tools/training-engine/fast.mjs --full",
    "engine:perf": "node tools/training-engine/perf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource/dancing-script": "5.3.0",
    "dexie": "4.4.7",
    "i18next": "26.5.12",
    "jose": "6.2.14",
    "lxgw-wenkai-webfont": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router-dom": "7.18.5",
    "three": "0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0",
    "yaml": "2.9.1"
  }
}
