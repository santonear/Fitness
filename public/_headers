# Security headers for every static response (Cloudflare Workers static assets).
# Sources are 'self' rather than a host name, so a CDN in front with another domain keeps working.
# The only outside source is Cloudflare Turnstile on the trial application page.
# CSP enforced after a report-only round on preview showed no violations (Bo 2026-10-23).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
