{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitness",
  "main": "src/backend/fitness-worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ADMIN_ACCESS_AUD": "062e97295d5c53acf80cde71b38ddcfe9c76eb522489c4d3c4ebaaaed8196fd6",
    "ADMIN_ACCESS_ISSUER": "https://tiny-firefly-ed38.cloudflareaccess.com",
    "ADMIN_EMAIL": "xxgospel@hotmail.com",
    "CONTROL_MODE": "external",
    "CONTROL_ORIGINS": "[\"https://fitness.initdevl.workers.dev\"]",
    "CONTROL_POLICY": "{\"timeZone\":\"Asia/Shanghai\",\"k\":14,\"budgetLimit\":3000,\"maximumRequestCost\":300,\"allowBoundedPending\":true,\"planningBudgetDisabled\":true,\"requestBounds\":{\"understand\":300,\"generate\":300},\"quotas\":{\"understand\":8,\"generate\":4},\"maxInputBytes\":65536,\"maxConcurrent\":2,\"allowUncertainPlanningPending\":true}",
    "DEEPSEEK_PRICING_VERIFIED_UNTIL": "2026-10-08T00:00:00Z",
    "FITNESS_FEATURE_FLAGS": "{}",
    "FITNESS_DAILY_LIMITS": "{\"calls\":1000,\"costFen\":3000}",
    "FITNESS_SUPPLIER_DIAGNOSTICS": "errors",
    "SUPPLIER_PROVIDER": "deepseek",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFQG0Iz8JvDHA3mo",
    "ADMIN_ENVIRONMENT": "production",
    "ADMIN_CONSOLE_ENABLED": "true",
    "ADMIN_PUSH_ENABLED": "false",
    "ADMIN_ERROR_COLLECTION_ENABLED": "true",
    "ADMIN_RELEASE_REGISTRY": "[{\"environment\":\"production\",\"dataVersion\":11,\"current\":{\"id\":\"admin-v8-20261012\",\"deploymentId\":\"4884ef3c-1470-4855-8634-1af7ed197764\",\"publishedAt\":\"2026-10-11T18:00:00Z\",\"compatibleDataVersion\":11,\"smokeOrigin\":\"https://fitness.initdevl.workers.dev\"},\"previous\":{\"id\":\"pr52-mainline\",\"deploymentId\":\"4884ef3c-1470-4855-8634-1af7ed197764\",\"publishedAt\":\"2026-10-11T14:12:40.060894Z\",\"compatibleDataVersion\":11,\"smokeOrigin\":\"https://fitness.initdevl.workers.dev\"}}]"
  },
  "d1_databases": [
    {
      "binding": "FITNESS_OPS_DB",
      "database_name": "fitness-ops-production",
      "migrations_dir": "migrations/ops"
    },
    {
      "binding": "CONTROL_DB",
      "database_name": "fitness-control-production",
      "database_id": "01214290-e46e-4e5b-a6fc-b007a1ecb08f"
    },
    {
      "binding": "ADMIN_DB",
      "database_name": "fitness-admin-production",
      "database_id": "e2b96324-7757-4f06-a758-660352dad58f",
      "migrations_dir": "migrations/admin"
    }
  ],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/api",
      "/admin",
      "/admin/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "FITNESS_FEATURE_CONFIG",
      "id": "ab0cd51b6ceb402f9f943e8edd66f0fe"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
