{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitness",
  "main": "src/backend/fitness-worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "CONTROL_MODE": "disabled"
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/api"
    ]
  }
}
